<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and older (backup is also disabled with allowBackup="false"): exclude everything,
    for the same reason as data_extraction_rules.xml. The settings hold pairing secrets, the
    TomTom API key and this install's phone id; a new phone pairs with the HUD again.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
