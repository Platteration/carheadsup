<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the app in the clear. The HUD is reached over TLS only (wss:// and https://
     to its self-signed certificate: the app pins that certificate itself, in HudTrustManager for
     its own connections and by fingerprint in the settings page's WebView), and everything on
     the internet (Overpass, TomTom) over HTTPS, trusting the system's certificate authorities. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
